{"legislative_session": "2026RS", "identifier": "HB375", "title": "AN ACT relating to automated license plate readers.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Corrections Impact", "Crimes And Punishments", "Technology", "Transportation"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Create a new section of KRS Chapter 189 to define \"automated license plate reader\" or \"ALPR\"; prohibit the use, deployment, and maintenance of an ALPR system; allow a person to bring a civil action for a violation and allow recovery of actual and punitive damages; make the use, deployment, and maintenance of an ALPR system a Class D felony and set a fine of $10,000."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-hb375"}], "actions": [{"description": "introduced in House", "date": "2026-01-14T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (H)", "date": "2026-01-14T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "to Transportation (H)", "date": "2026-01-22T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}], "sponsorships": [], "related_bills": [], "versions": [{"note": "Introduced", "links": [{"url": "https://apps.legislature.ky.gov/recorddocuments/bill/26RS/hb375/orig_bill.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://apps.legislature.ky.gov/record/26RS/hb375.html", "note": ""}], "extras": {"BDR": "1609"}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:ky/government", "name": "Kentucky", "classification": "state", "division_id": "ocd-division/countr