{"legislative_session": "2026RS", "identifier": "HB755", "title": "AN ACT relating to associations and individual representation rights.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Collective Bargaining", "Labor And Industry", "Local Mandate", "Public Officers And Employees", "State Employees", "Workforce"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Create a new section of KRS Chapter 336 to allow public employee collective bargaining organizations to represent only dues-paying members; allow nonmember employees to be represented by counsel of their choosing, subject to reasonable employer procedures; grant the labor organization the right to represent a nonmember employee in an action involving the interpretation or enforcement of a collective bargaining agreement; allow nonmember employees to enter into a written agreement with the labor organization for representation for a reasonable fee; apply to agreements entered into or renewed on or after the effective date of the Act."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-hb755"}], "actions": [{"description": "introduced in House", "date": "2026-02-25T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (H)", "date": "2026-02-25T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "to Local Government (H)", "date": "2026-03-04T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "taken from Local Government (H)", "date": "2026-03-13T04:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "1st reading",