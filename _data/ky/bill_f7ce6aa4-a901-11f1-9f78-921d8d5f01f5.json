{"legislative_session": "2026RS", "identifier": "HB911", "title": "AN ACT relating to planning and zoning.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Business Entities And Organizations", "Cities", "Civil Actions", "Commerce", "Counties", "Land Use", "Local Government", "Planning And Zoning"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Amend KRS 100.326 to define terms; prohibit planning units from adopting or enforcing certain specified ordinances or regulations concerning aspects of commercial uses; state that a single principal structure or building on a single lot in a commercial zone for a permitted use shall be approved without a development plan; establish a cause of action by a developer to bring suit for a violation of the section; create a new section of KRS Chapter 100 to state that a planning units activities are subject to its own land use and planning and zoning regulations."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-hb911"}], "actions": [{"description": "introduced in House", "date": "2026-03-04T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (H)", "date": "2026-03-04T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "to Local Government (H)", "date": "2026-03-11T04:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "taken from Local Government (H)", "date": "2026-03-13T04:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "1st reading", "date": "2026-03-13T04:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}"