{"legislative_session": "2026RS", "identifier": "HB248", "title": "AN ACT relating to hospital police departments.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Hospitals And Health Facilities", "Peace Officers And Law Enforcement", "Public Safety"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Create new sections of KRS Chapter 216B to allow certain hospitals licensed under that chapter to establish hospital police departments; provide each hospital police officer with full general police powers, including the power to arrest, in performing his or her duties; specify the qualifications each officer shall have at the time of his or her employment; provide for the appointment or promotion to the ranks and grades of the department; prohibit persons from falsely representing themselves to be an officer; establish a citizen complaint and investigation process for complaints against an officer alleging misconduct."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-hb248"}], "actions": [{"description": "introduced in House", "date": "2026-01-08T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (H)", "date": "2026-01-08T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "to Judiciary (H)", "date": "2026-01-15T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "reassigned to Veterans, Military Affairs, & Public Protection (H)", "date": "2026-03-03T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "reported favorably, 1st reading, to Calendar", "date": "2026-