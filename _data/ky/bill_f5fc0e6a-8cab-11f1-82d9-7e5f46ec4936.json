{"legislative_session": "2026RS", "identifier": "HB855", "title": "AN ACT relating to persons entitled to vote.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Boards And Commissions", "Children And Minors", "County Clerks", "Elections And Voting", "Local Mandate", "State Agencies"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Amend KRS 116.025 to permit voters 16 and 17 years of age to vote in local school board elections upon local approval by a school board; create a new section of KRS Chapter 116 to require county clerks to administer the registration and voting of persons 16 and 17 years of age; allow voters who are 16 and 17 years of age to receive ballots limited to school board contests; require the State Board of Elections to promulgate administrative regulations to establish the procedure for persons 16 and 17 years of age to register and vote for school board elections."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-hb855"}], "actions": [{"description": "introduced in House", "date": "2026-03-03T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (H)", "date": "2026-03-03T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "to Elections, Const. Amendments & Intergovernmental Affairs (H)", "date": "2026-03-10T04:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}], "sponsorships": [{"name": "R. Roarx", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"R. Roarx\"}", "organization_id": null}, {"name": "A. Donworth", "classification": "primary", "entity_type": "person", "primary": true, "person_id":