{"legislative_session": "2026RS", "identifier": "SB288", "title": "AN ACT relating to the rights of tenants.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": ["Landlord And Tenant", "Local Government", "Local Mandate", "Property", "Real Estate"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Create a new section of KRS Chapter 383 to define terms; state that a tenant has a right of first refusal to purchase a rental property from the owner of the property; require the owner to notify a tenant prior to listing a rental property for sale or accepting an offer on the property; establish timelines for a tenant to exercise the right of first refusal; specify circumstances under which a tenant's right of first refusal may be waived; establish penalty for violation."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-sb288"}], "actions": [{"description": "introduced in Senate", "date": "2026-02-27T05:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (S)", "date": "2026-02-27T05:00:00+00:00", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": []}], "sponsorships": [], "related_bills": [], "versions": [{"note": "Introduced", "links": [{"url": "https://apps.legislature.ky.gov/recorddocuments/bill/26RS/sb288/orig_bill.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [{"note": "Fiscal Note", "links": [{"url": "https://apps.legislature.ky.gov/recorddocuments/note/26RS/sb288/LM.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "citations": [], "sources": [{"url": "https://apps.legislature.ky.gov/record/26RS/sb288.html", "note": ""}], "extras": {"BDR": "2281"}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:ky/governmen