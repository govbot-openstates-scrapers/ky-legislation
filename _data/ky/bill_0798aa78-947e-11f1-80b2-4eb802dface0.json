{"legislative_session": "2026RS", "identifier": "HB44", "title": "AN ACT relating to robotics.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Administrative Regulations And Proceedings", "Appropriations", "Boards And Commissions", "Education, Elementary And Secondary", "Education, Finance", "Education, Vocational", "Funds", "Reports Mandated", "Science And Technology", "Short Titles And Popular Names", "Technology"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Create a new section of KRS Chapter 158 to define terms; establish the robotics competition fund; establish the Robotics Funding Selection Committee to award grants from the fund to eligible robotics teams competition sponsors; establish committee membership, duties, and set terms; require the Kentucky Department of Education to promulgate administrative regulations to establish procedures for grant applications and distribution of awards by April 1, 2027; set requirements for grant applications; require annual report by August 1 to Legislative Research Commission; provide for initial staggering of appointments; require the committee to hold its first meeting by October 15, 2026; provide that the Act may be cited as the Advanced Manufacturing Through Robotics Education Act."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-hb44"}], "actions": [{"description": "introduced in House", "date": "2026-01-07T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (H)", "date": "2026-01-07T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "to Primary and Secondary Education (H)", "date": "2026-01-14T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["r