{"legislative_session": "2026RS", "identifier": "HB60", "title": "AN ACT relating to geoengineering.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Corrections Impact", "Crimes And Punishments", "Environment And Conservation", "Notices", "Pollution", "Public Safety"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Create a new section of KRS Chapter 512 to define terms; make criminal atmospheric pollution a Class D felony; require that a person found guilty of criminal atmospheric pollution pay a civil penalty of not less than $500,000 in addition to all other penalties authorized by law; provide that each day that a person engages in criminal atmospheric pollution constitutes a separate offense; empower all peace officers of the Commonwealth to enforce the prohibition on criminal atmospheric pollution; require an arresting officer to issue a notice to any federal agency that approved the action that those activities cannot be lawfully carried out in the Commonwealth."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-hb60"}], "actions": [{"description": "introduced in House", "date": "2026-01-07T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (H)", "date": "2026-01-07T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "to Judiciary (H)", "date": "2026-01-14T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "reassigned to Natural Resources & Energy (H)", "date": "2026-01-20T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "reported favorably, 1st re