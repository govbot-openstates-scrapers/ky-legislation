{"legislative_session": "2026RS", "identifier": "HB318", "title": "AN ACT relating to property rights in name, voice, and likeness.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Civil Actions", "Civil Procedure", "Communications", "Information Technology", "Property", "Science And Technology", "Technology", "Telecommunications"], "abstracts": [{"note": "Summary of Original Version", "abstract": "Create a new section of KRS Chapter 365 to define terms; establish property rights in every individual's name, voice, and likeness; establish how the property rights may be transferred or terminated; establish a civil cause of action and damages for unauthorized use of an individual's name, voice, or likeness; provide exceptions; require that an action commence within 4 years of discovery of the violation."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ky-2026rs-hb318"}], "actions": [{"description": "introduced in House", "date": "2026-01-12T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "to Committee on Committees (H)", "date": "2026-01-12T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}, {"description": "to Judiciary (H)", "date": "2026-01-20T05:00:00+00:00", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": []}], "sponsorships": [], "related_bills": [], "versions": [{"note": "Introduced", "links": [{"url": "https://apps.legislature.ky.gov/recorddocuments/bill/26RS/hb318/orig_bill.pdf", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://apps.legislature.ky.gov/record/26RS/hb318.html", "note": ""}], "extras": {"BDR": "348"}, "jurisdiction": {"id": "ocd-jurisdicti